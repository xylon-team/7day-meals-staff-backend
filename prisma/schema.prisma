// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Add your models here


model customer {
  customer_id      Int      @id @default(autoincrement())
  fname            String   @db.VarChar(100)
  lname            String   @db.VarChar(100)
  phone_number     String   @db.VarChar(15)
  latitude         Decimal? @db.Decimal(10, 8)
  longitude        Decimal? @db.Decimal(11, 8)
  address_line_1   String?  @db.VarChar(100)
  address_line_2   String?  @db.VarChar(100)
  is_active        Boolean  @default(true)
  is_deleted       Boolean  @default(false)
  delete_timestamp DateTime?
  registration_date DateTime @default(now())
  credential         customer_credential?
  orders             customer_order[]
  subscriptions      subscription[]
  complaints         complaint[]
}

model customer_credential {
  customer_credential_id Int      @id @default(autoincrement())
  customer_id            Int      @unique
  customer               customer @relation(fields: [customer_id], references: [customer_id])
  email                  String   @db.VarChar(100)
  customer_password      String   @db.VarChar(255)
}

model meal_plan {
  meal_id              Int      @id @default(autoincrement())
  item_name            String   @db.VarChar(100)
  category             String   @db.VarChar(100)
  description          String   @db.VarChar(1000)
  dietary_preference   String   @db.VarChar(100)
  price                Decimal  @db.Decimal(10, 2)
  image_path           String?  @db.VarChar(255)
  is_available         Boolean  @default(true)
  food_items           meal_plan_food_item[]
  orders               customer_order[]
  subscriptions        subscription[]
}

model food_item {
  food_item_id      Int     @id @default(autoincrement())
  item_name         String  @db.VarChar(100)
  ingredient_list   String  @db.VarChar(2000)
  image_path        String? @db.VarChar(255)
  meal_plans        meal_plan_food_item[]
}

model meal_plan_food_item {
  meal_id      Int      @db.Int
  food_item_id Int      @db.Int
  day          String   @db.VarChar(50)
  meal_type    String   @db.VarChar(100)

  meal_plan    meal_plan   @relation(fields: [meal_id], references: [meal_id])
  food_item    food_item   @relation(fields: [food_item_id], references: [food_item_id])

  @@id([meal_id, food_item_id])
}

model delivery_person {
  delivery_person_id Int     @id @default(autoincrement())
  rider_name         String  @db.VarChar(100)
  phone_number       String  @db.VarChar(15)
  orders             customer_order[]
}

model customer_order {
  order_id                Int               @id @default(autoincrement())
  customer_id             Int               @db.Int
  meal_id                 Int               @db.Int
  order_timestamp         DateTime          @default(now())
  delivery_person_id      Int?              @db.Int
  order_status            String            @db.VarChar(50)
  payment_status          String            @db.VarChar(50)
  delivery_status         String            @db.VarChar(50)
  delivery_preferred_date DateTime
  is_a_subscribed_meal    Boolean           @default(false)
  offer_id                Int?              @db.Int

  customer          customer         @relation(fields: [customer_id], references: [customer_id])
  meal_plan         meal_plan        @relation(fields: [meal_id], references: [meal_id])
  delivery_person   delivery_person? @relation(fields: [delivery_person_id], references: [delivery_person_id])
  offer             offer?           @relation(fields: [offer_id], references: [offer_id])
  feedback          delivery_feedback[]
}

model subscription {
  subscription_id          Int      @id @default(autoincrement())
  customer_id              Int      @db.Int
  meal_id                  Int      @db.Int
  subscribe_date            DateTime @default(now())
  canceled_date            DateTime?
  delivery_preferred_date  DateTime

  customer    customer  @relation(fields: [customer_id], references: [customer_id])
  meal_plan   meal_plan @relation(fields: [meal_id], references: [meal_id])
}

model delivery_feedback {
  feedback_id   Int      @id @default(autoincrement())
  order_id      Int      @db.Int
  rating_value  Int      @db.Int
  description   String?  @db.VarChar(5000)
  image_path    String?  @db.VarChar(255)
  reply         String?  @db.VarChar(5000)
  replied_date  DateTime?

  order         customer_order @relation(fields: [order_id], references: [order_id])
}

model offer {
  offer_id        Int      @id @default(autoincrement())
  coupon_number   String   @unique @db.VarChar(50)
  expiry_date     DateTime
  usage_limit     Int      @db.Int
  min_order_value Decimal  @db.Decimal(10, 2)
  title           String   @db.VarChar(100)
  description     String   @db.VarChar(1000)
  amount          Decimal  @db.Decimal(10, 2)
  is_enabled      Boolean  @default(true)

  orders          customer_order[]
}

model complaint {
  complaint_id     Int      @id @default(autoincrement())
  customer_id      Int      @db.Int
  description      String   @db.VarChar(5000)
  date_submitted   DateTime @default(now())
  resolution_note  String?  @db.VarChar(1000)
  resolved_date    DateTime?
  is_resolved      Boolean  @default(false)

  customer         customer @relation(fields: [customer_id], references: [customer_id])
}

model staff {
  staff_id     Int     @id @default(autoincrement())
  fname        String  @db.VarChar(100)
  lname        String  @db.VarChar(100)
  phone_number String  @db.VarChar(15)
  status       String  @db.VarChar(50)
  credential   staff_credential?
  staff_roles staff_role[]
  stock_adjustments stock_adjustment[]
  supplier_requests supplier_request[]
}

model staff_credential {
  staff_credential_id Int      @id @default(autoincrement())
  staff_id            Int      @unique
  staff               staff    @relation(fields: [staff_id], references: [staff_id])
  email               String   @db.VarChar(100)
  staff_password      String   @db.VarChar(255)
}

model role {
  role_id     Int     @id @default(autoincrement())
  role        String  @db.VarChar(100)
  description String  @db.VarChar(500)
  staff_roles staff_role[]
  role_permissions role_permission[]
}

model permission {
  permission_id    Int     @id @default(autoincrement())
  permission_type  String  @db.VarChar(500)
  role_permissions role_permission[]
}

model staff_role {
  staff_id Int @db.Int
  role_id  Int @db.Int

  staff staff @relation(fields: [staff_id], references: [staff_id])
  role  role  @relation(fields: [role_id], references: [role_id])

  @@id([staff_id, role_id])
}

model role_permission {
  role_id       Int @db.Int
  permission_id Int @db.Int

  role       role       @relation(fields: [role_id], references: [role_id])
  permission permission @relation(fields: [permission_id], references: [permission_id])

  @@id([role_id, permission_id])
}

model supplier {
  supplier_id   Int     @id @default(autoincrement())
  name          String  @db.VarChar(100)
  agent_name    String  @db.VarChar(100)
  email         String  @db.VarChar(100)
  phone_number  String  @db.VarChar(15)
  address_line_1 String? @db.VarChar(200)
  address_line_2 String? @db.VarChar(200)
  address_line_3 String? @db.VarChar(200)
  inventory_items supplier_inventory_item[]
  supplier_requests supplier_request[]
  purchase_orders  purchase_order[]
}

model inventory_item {
  inventory_id       Int      @id @default(autoincrement())
  ingredient_name    String   @db.VarChar(100)
  category            String   @db.VarChar(100)
  unit                String   @db.VarChar(50)
  current_quantity    Int      @db.Int
  normal_stock_level  Int      @db.Int
  low_stock_level     Int      @db.Int
  is_out_of_stock     Boolean  @default(false)
  expiry_date         DateTime?
  unit_price          Decimal  @db.Decimal(10, 2)
  updated_timestamp   DateTime @updatedAt
  suppliers          supplier_inventory_item[]
  stock_adjustments  stock_adjustment[]
  supplier_requests  supplier_request[]
}

model supplier_inventory_item {
  supplier_id    Int     @db.Int
  inventory_id  Int     @db.Int
  is_available  Boolean @default(true)

  supplier   supplier        @relation(fields: [supplier_id], references: [supplier_id])
  inventory  inventory_item  @relation(fields: [inventory_id], references: [inventory_id])

  @@id([supplier_id, inventory_id])
}

model stock_adjustment {
  stock_adjust_id   Int      @id @default(autoincrement())
  inventory_id     Int      @db.Int
  staff_id          Int      @db.Int
  adjustment_type  String   @db.VarChar(100)
  quantity         Int      @db.Int
  batch_number      String?  @db.VarChar(255)
  expiry_date      DateTime?
  entered_date     DateTime @default(now())
  remarks          String?  @db.VarChar(2000)

  inventory  inventory_item @relation(fields: [inventory_id], references: [inventory_id])
  staff      staff          @relation(fields: [staff_id], references: [staff_id])
}

model supplier_request {
  supplier_req_id Int      @id @default(autoincrement())
  supplier_id     Int      @db.Int
  inventory_id    Int      @db.Int
  quantity        Int      @db.Int
  requested_date  DateTime @default(now())
  required_date   DateTime
  status          String   @db.VarChar(50)
  remarks         String?  @db.VarChar(2000)
  staff_id        Int      @db.Int

  supplier   supplier        @relation(fields: [supplier_id], references: [supplier_id])
  inventory  inventory_item  @relation(fields: [inventory_id], references: [inventory_id])
  staff      staff          @relation(fields: [staff_id], references: [staff_id])
}

model setting {
  setting_id     Int     @id @default(autoincrement())
  delivery_radius Int     @db.Int
  latitude       Decimal @db.Decimal(10, 8)
  longitude      Decimal @db.Decimal(11, 8)
  delivery_fee   Decimal @db.Decimal(10, 2)
}

model purchase_order {
  po_id        Int      @id @default(autoincrement())
  supplier_id  Int      @db.Int
  item_count   Int      @db.Int
  date         DateTime @default(now())
  status       String   @db.VarChar(100)

  supplier  supplier @relation(fields: [supplier_id], references: [supplier_id])
}


