# QA environment for e2e tests. Copy this file to ".env.qa" and fill in real values.
# .env.qa is gitignored and must never be committed.

# Application Configuration
PORT=3000
NODE_ENV=development

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=""

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=""

# JWT Configuration
JWT_SECRET=generate_a_secure_random_secret_key_here
JWT_EXPIRES_IN=1d

# Admin credentials used by the e2e global setup to provision the test staff account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Test staff account credentials. The global setup creates this account (if missing)
# and the e2e specs log in with it. Password must satisfy the staff password policy:
# >= 8 chars, >= 1 uppercase, 1 lowercase, 1 digit, 1 special char from @$!%*?&
TEST_STAFF_EMAIL=e2e-test-staff@7daymeals.local
TEST_STAFF_PASSWORD=TestPass1!

# SMTP Configuration (placeholder values are fine; e2e specs do not exercise email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=your_email@gmail.com
