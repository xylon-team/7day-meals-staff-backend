# QA environment for e2e tests. Copy this file to ".env.qa" and fill in real values.
# .env.qa is gitignored and must never be committed.

# Application Configuration
PORT=8001
NODE_ENV=development

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.leypjdcrnqjuxwgqlzyu:verystrongpassword122@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.leypjdcrnqjuxwgqlzyu:verystrongpassword122@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# JWT Configuration
JWT_SECRET=h/dBLt0dH/1xgjfZJPzCNKAarMLDSZOquWyGG0ccTrA=
JWT_EXPIRES_IN=1d

# Admin credentials used by the e2e global setup to provision the test staff account
