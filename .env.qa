TEST_STAFF_PASSWORD=TestPass1!

# SMTP Configuration (placeholder values are fine; e2e specs do not exercise email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=your_email@gmail.com
